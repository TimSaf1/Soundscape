# 1. Секретный ключ Django (обязательно сгенерируйте новый)
SECRET_KEY=django-insecure-0iwJjfqC8kVOORGBm0muDTXsCA1oHDIXJxlgjyklJisHgIWSS7

# 2. Режим отладки 
# На сервере это всегда False. Дома можно True, чтобы видеть ошибки в браузере.
DEBUG=True

# 3. Разрешенные хосты 
# Для локального сервера пишем localhost и 127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# 4. База данных PostgreSQL (для работы на ВАШЕМ ПК)
# Если у вас установлена программа pgAdmin или Postgres.app:
DATABASE_URL=postgres://myuser:mypassword@127.0.0.1:5432/mydatabase

# ПРИМЕРЫ ЗНАЧЕНИЙ ДЛЯ ЛОКАЛЬНОЙ МАШИНЫ:
# DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/django_db
# Если используете Docker для базы:
# DATABASE_URL=postgres://postgres:password@db:5432/railway

# 5. Дополнительные настройки (опционально)
# Отключает сборку статики при каждом запуске dev-сервера (ускоряет работу)
DISABLE_COLLECTSTATIC=1

NEXT_PUBLIC_SITE_URL=https://soundscape2.up.railway.app
